{
  "name": "market-report-generator",
  "version": "1.0.0",
  "description": "AI-powered market research report generator with Web UI and Netlify serverless functions",
  "main": "server.py",
  "scripts": {
    "start": "python server.py",
    "dev": "netlify dev",
    "deploy": "netlify deploy --prod",
    "test": "python -m unittest discover tests",
    "postinstall": "npm install jszip"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
